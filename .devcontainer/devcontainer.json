{
	"name": "Eaglercraft Server",
	"remoteEnv": {
		"PATH": "${containerWorkspaceFolder}/bin:${containerWorkspaceFolder}:${containerEnv:PATH}"
	},
	"forwardPorts": [8081, 8082, 25565],
	"portsAttributes": {
		"8081": {
			"label": "Eaglercraft Gateway",
			"onAutoForward": "notify",
			"visibility": "public"
		},
		"8082": {
			"label": "Recource Pack",
			"onAutoForward": "notify",
			"visibility": "public"
		},
		"25565": {
			"label": "BungeeCord",
			"onAutoForward": "silent"
		},
		"25566": {
			"label": "Game Server"
		}
	}
}